# systemd unit for the Buoni postali home server.
# Adjust User and the paths if your user is not "pi" or the repo lives elsewhere.
#
#   sudo cp deploy/buoni-postali.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now buoni-postali

[Unit]
Description=Buoni postali home server
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/buoni-postali
Environment=PORT=8080
Environment=HOST=0.0.0.0
Environment=DATA_DIR=/home/pi/buoni-postali/data
ExecStart=/usr/bin/node server/server.mjs
Restart=on-failure

# Hardening: the server only needs to read the app and write its data folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/buoni-postali/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
