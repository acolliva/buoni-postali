# systemd unit template for the Buoni postali home server.
# Don't copy it by hand: run ./deploy/install-service.sh, which fills in
# your user, repo folder and Node.js path.

[Unit]
Description=Buoni postali home server
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/buoni-postali
Environment=PORT=9999
Environment=HOST=0.0.0.0
Environment=DATA_DIR=/home/pi/buoni-postali/data
ExecStart=/usr/bin/node server/server.mjs
Restart=on-failure

# Hardening: the server only needs to read the app and write its data folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/buoni-postali/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
